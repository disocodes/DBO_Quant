# DBO_Quant core
FINANCE_CATALOG=REPLACE_WITH_CATALOG
FINANCE_SCHEMA=openbb_quant
DATABRICKS_WAREHOUSE_ID=REPLACE_WITH_WAREHOUSE_ID
OPENBB_ALLOWED_ORIGINS=https://pro.openbb.co

# Optional OpenBB provider credentials
FMP_API_KEY=
FRED_API_KEY=
INTRINIO_API_KEY=
TIINGO_TOKEN=
BENZINGA_API_KEY=

# Optional Databricks Jobs
BACKTEST_JOB_ID=
MONTE_CARLO_JOB_ID=
COMPARISON_JOB_ID=

# NVIDIA GPU workflow configuration
# External/on-prem route: use a configured Databricks CLI/profile if needed.
DATABRICKS_PROFILE=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE_WITH_WAREHOUSE_ID
DBO_CATALOG=REPLACE_WITH_CATALOG
DBO_SCHEMA=openbb_quant
DBO_PORTFOLIO_ID=
DBO_SYMBOLS=SPY,QQQ,IEF,GLD
DBO_RISK_AVERSION=1.0
DBO_CONFIDENCE=0.95
DBO_NUM_SCENARIOS=10000
DBO_FRONTIER_POINTS=25
DBO_RUN_REBALANCING=false
DBO_TRANSACTION_COST_FACTOR=0.0
DBO_LOOK_BACK_WINDOW=126
DBO_LOOK_FORWARD_WINDOW=21
DBO_PUSH_RESULTS=true
