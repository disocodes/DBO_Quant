# Optional environment settings only.
# Portfolio/optimizer settings live in:
# gpu/nvidia_portfolio_optimization/portfolio_config.toml

# Databricks App deployment (only when needed)
FINANCE_CATALOG=
FINANCE_SCHEMA=openbb_quant
DATABRICKS_WAREHOUSE_ID=
OPENBB_ALLOWED_ORIGINS=https://pro.openbb.co
BACKTEST_JOB_ID=
MONTE_CARLO_JOB_ID=
COMPARISON_JOB_ID=

# Optional OpenBB provider credentials
FMP_API_KEY=
FRED_API_KEY=
INTRINIO_API_KEY=
TIINGO_TOKEN=
BENZINGA_API_KEY=

# External/on-prem NVIDIA GPU route only.
# Option A: set DATABRICKS_PROFILE and the SQL Warehouse HTTP path.
DATABRICKS_PROFILE=
DATABRICKS_HTTP_PATH=
DBO_CATALOG=
DBO_SCHEMA=openbb_quant

# Option B: leave DATABRICKS_PROFILE empty and set DATABRICKS_HOST.
# The external notebook will use OAuth U2M browser sign-in.
DATABRICKS_HOST=
